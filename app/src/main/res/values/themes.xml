<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

  <style name="Theme.RyzixPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    <item name="colorPrimary">@color/primary</item>
    <item name="colorPrimaryDark">@color/primary_dark</item>
    <item name="colorAccent">@color/accent</item>
    <item name="android:colorBackground">@color/background</item>
    <item name="colorSurface">@color/surface</item>
    <item name="colorOnPrimary">@color/on_primary</item>
    <item name="colorOnSurface">@color/on_surface</item>
    <item name="android:statusBarColor">@color/transparent</item>
    <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="android:windowAnimationStyle">@style/Anim.Ryzix.Activity</item>
    <item name="materialAlertDialogTheme">@style/Theme.RyzixPlayer.Dialog</item>
    <item name="bottomNavigationStyle">@style/Widget.Ryzix.BottomNav</item>
    <item name="chipStyle">@style/Widget.Ryzix.Chip</item>
  </style>

  <style name="Theme.RyzixPlayer.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowBackground">@android:color/black</item>
  </style>

  <style name="Theme.RyzixPlayer.Player" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowAnimationStyle">@style/Anim.Ryzix.Player</item>
  </style>

  <style name="Theme.RyzixPlayer.MusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/music_bg_dark</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>
    <item name="android:windowAnimationStyle">@style/Anim.Ryzix.Player</item>
  </style>

  <style name="Theme.RyzixPlayer.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
    <item name="colorPrimary">@color/accent</item>
    <item name="colorAccent">@color/accent</item>
    <item name="android:colorBackground">@color/surface_elevated</item>
    <item name="colorOnSurface">@color/on_surface</item>
  </style>

  <style name="Theme.RyzixPlayer.BottomSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/Widget.Ryzix.BottomSheet</item>
    <item name="colorPrimary">@color/accent</item>
    <item name="android:colorBackground">@color/surface_elevated</item>
  </style>

  <style name="Widget.Ryzix.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
    <item name="android:background">@drawable/bg_bottom_sheet</item>
    <item name="behavior_peekHeight">400dp</item>
  </style>

  <style name="Widget.Ryzix.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
    <item name="android:background">@color/bottom_nav_bg</item>
    <item name="itemActiveIndicatorStyle">@style/Widget.Ryzix.BottomNav.Indicator</item>
    <item name="itemIconTint">@color/bottom_nav_item_color</item>
    <item name="itemTextColor">@color/bottom_nav_item_color</item>
    <item name="elevation">0dp</item>
  </style>

  <style name="Widget.Ryzix.BottomNav.Indicator">
    <item name="android:color">@color/bottom_nav_indicator</item>
    <item name="shapeAppearance">@style/ShapeAppearance.Ryzix.BottomNav.Indicator</item>
  </style>

  <style name="ShapeAppearance.Ryzix.BottomNav.Indicator" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">50%</item>
  </style>

  <style name="Widget.Ryzix.Chip" parent="Widget.MaterialComponents.Chip.Action">
    <item name="chipBackgroundColor">@color/surface_glass</item>
    <item name="android:textColor">@color/on_surface</item>
    <item name="chipStrokeColor">@color/glass_stroke</item>
    <item name="chipStrokeWidth">1dp</item>
  </style>

  <style name="SeekBar.Player" parent="Widget.AppCompat.SeekBar">
    <item name="android:progressTint">@color/seek_bar_progress</item>
    <item name="android:thumbTint">@color/seek_bar_thumb</item>
    <item name="android:secondaryProgressTint">@color/seek_bar_secondary</item>
    <item name="android:progressBackgroundTint">#33FFFFFF</item>
  </style>

  <style name="SeekBar.Music" parent="Widget.AppCompat.SeekBar">
    <item name="android:progressTint">@color/seek_bar_progress</item>
    <item name="android:thumbTint">@color/seek_bar_thumb</item>
    <item name="android:secondaryProgressTint">@color/seek_bar_secondary</item>
    <item name="android:progressBackgroundTint">#33FFFFFF</item>
  </style>

  <style name="SeekBar.Equalizer" parent="Widget.AppCompat.SeekBar">
    <item name="android:progressTint">@color/accent</item>
    <item name="android:thumbTint">@color/accent</item>
    <item name="android:progressBackgroundTint">@color/surface_variant</item>
  </style>

  <style name="Anim.Ryzix.Activity" parent="@android:style/Animation.Activity">
    <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
    <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
    <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
    <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
  </style>

  <style name="Anim.Ryzix.Player" parent="@android:style/Animation.Activity">
    <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
    <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
    <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
    <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
  </style>

</resources>
