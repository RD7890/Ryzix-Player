<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background"
  android:fitsSystemWindows="true">

  <!-- ── Glassmorphism header ─────────────────────────────────────────── -->
  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/appBarLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_header"
    android:fitsSystemWindows="true"
    app:elevation="0dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="64dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="20dp"
      android:paddingEnd="12dp">

      <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="RYZIX"
        android:textColor="@color/on_surface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"/>

      <ImageButton
        android:id="@+id/btnSearch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_search"
        android:tint="@color/on_surface"
        android:padding="8dp"
        android:contentDescription="@string/action_search"/>

      <ImageButton
        android:id="@+id/btnSort"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_sort"
        android:tint="@color/on_surface"
        android:padding="8dp"
        android:contentDescription="@string/action_sort"/>

    </LinearLayout>

    <!-- Search bar (animated show/hide) -->
    <LinearLayout
      android:id="@+id/layoutSearchBar"
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp"
      android:paddingBottom="8dp"
      android:visibility="gone">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/bg_search_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:src="@drawable/ic_search"
          android:tint="@color/on_surface_variant"/>

        <EditText
          android:id="@+id/etSearch"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:background="@null"
          android:hint="@string/search_hint"
          android:textColorHint="@color/search_hint"
          android:imeOptions="actionSearch"
          android:inputType="text"
          android:maxLines="1"
          android:singleLine="true"
          android:textColor="@color/on_surface"
          android:textSize="14sp"/>

        <ImageButton
          android:id="@+id/btnClearSearch"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:background="@null"
          android:src="@drawable/ic_close"
          android:tint="@color/on_surface_variant"
          android:contentDescription="Clear"
          android:visibility="gone"/>

      </LinearLayout>

      <TextView
        android:id="@+id/tvCancelSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Cancel"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:padding="4dp"/>

    </LinearLayout>

  </com.google.android.material.appbar.AppBarLayout>

  <!-- ── Content pager ───────────────────────────────────────────── -->
  <androidx.viewpager2.widget.ViewPager2
    android:id="@+id/viewPager"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

  <!-- ── Bottom chrome (mini-bar + nav) stacked at the bottom ──── -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical">

    <!-- Now-Playing mini bar (hidden until music plays) -->
    <LinearLayout
      android:id="@+id/layoutNowPlaying"
      android:layout_width="match_parent"
      android:layout_height="64dp"
      android:background="@drawable/bg_glass_nav"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="12dp"
      android:visibility="gone">

      <!-- Album art -->
      <ImageView
        android:id="@+id/imgNowPlayingArt"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:background="@drawable/bg_music_art"
        android:padding="2dp"/>

      <!-- Title + artist -->
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvNowPlayingTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="marquee"
          android:marqueeRepeatLimit="marquee_forever"
          android:singleLine="true"
          android:text="Not playing"
          android:textColor="@color/on_surface"
          android:textSize="13sp"
          android:textStyle="bold"/>

        <TextView
          android:id="@+id/tvNowPlayingArtist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/on_surface_variant"
          android:textSize="11sp"/>

      </LinearLayout>

      <!-- Play / Pause -->
      <ImageButton
        android:id="@+id/btnNowPlayingPlayPause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_play"
        android:tint="@color/on_surface"
        android:padding="8dp"
        android:contentDescription="Play/Pause"/>

      <!-- Next -->
      <ImageButton
        android:id="@+id/btnNowPlayingNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_skip_next"
        android:tint="@color/on_surface"
        android:padding="8dp"
        android:contentDescription="Next"/>

    </LinearLayout>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
      android:id="@+id/bottomNav"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_glass_nav"
      app:menu="@menu/bottom_nav_menu"
      app:labelVisibilityMode="labeled"
      app:itemIconTint="@color/bottom_nav_item_color"
      app:itemTextColor="@color/bottom_nav_item_color"
      app:elevation="0dp"/>

  </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
