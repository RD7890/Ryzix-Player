<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/bg_bottom_sheet"
  android:orientation="vertical"
  android:paddingBottom="24dp">

  <!-- Handle -->
  <View
    android:layout_width="36dp"
    android:layout_height="4dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="12dp"
    android:background="@color/divider"
    android:layout_marginBottom="0dp"/>

  <!-- Header -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/equalizer"
      android:textColor="@color/on_surface"
      android:textSize="18sp"
      android:textStyle="bold"/>

    <com.google.android.material.chip.Chip
      android:id="@+id/chipPreset"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/eq_flat"
      style="@style/Widget.Ryzix.Chip"
      app:chipIconVisible="false"/>

  </LinearLayout>

  <!-- EQ Bands (5-band horizontal) -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:gravity="bottom|center_horizontal"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingBottom="8dp">

    <!-- 60 Hz -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvBand0Val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"/>

      <SeekBar
        android:id="@+id/seekBand0"
        style="@style/SeekBar.Equalizer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="6dp"
        android:rotation="270"
        android:max="100"
        android:progress="50"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hz_60"
        android:textColor="@color/on_surface_variant"
        android:textSize="9sp"
        android:gravity="center"/>

    </LinearLayout>

    <!-- 230 Hz -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvBand1Val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"/>

      <SeekBar
        android:id="@+id/seekBand1"
        style="@style/SeekBar.Equalizer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="6dp"
        android:rotation="270"
        android:max="100"
        android:progress="50"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hz_230"
        android:textColor="@color/on_surface_variant"
        android:textSize="9sp"
        android:gravity="center"/>

    </LinearLayout>

    <!-- 910 Hz -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvBand2Val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"/>

      <SeekBar
        android:id="@+id/seekBand2"
        style="@style/SeekBar.Equalizer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="6dp"
        android:rotation="270"
        android:max="100"
        android:progress="50"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hz_910"
        android:textColor="@color/on_surface_variant"
        android:textSize="9sp"
        android:gravity="center"/>

    </LinearLayout>

    <!-- 3.6 kHz -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvBand3Val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"/>

      <SeekBar
        android:id="@+id/seekBand3"
        style="@style/SeekBar.Equalizer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="6dp"
        android:rotation="270"
        android:max="100"
        android:progress="50"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/khz_3_6"
        android:textColor="@color/on_surface_variant"
        android:textSize="9sp"
        android:gravity="center"/>

    </LinearLayout>

    <!-- 14 kHz -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvBand4Val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"/>

      <SeekBar
        android:id="@+id/seekBand4"
        style="@style/SeekBar.Equalizer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="6dp"
        android:rotation="270"
        android:max="100"
        android:progress="50"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/khz_14"
        android:textColor="@color/on_surface_variant"
        android:textSize="9sp"
        android:gravity="center"/>

    </LinearLayout>

  </LinearLayout>

  <View android:layout_width="match_parent" android:layout_height="1dp"
    android:layout_marginHorizontal="20dp" android:background="@color/divider"
    android:layout_marginBottom="16dp"/>

  <!-- Bass boost row -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingBottom="12dp">

    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:src="@drawable/ic_bass"
      android:tint="@color/on_surface_variant"/>

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:text="@string/bass_boost"
      android:textColor="@color/on_surface"
      android:textSize="14sp"/>

    <TextView
      android:id="@+id/tvBassVal"
      android:layout_width="44dp"
      android:layout_height="wrap_content"
      android:text="0%"
      android:textColor="@color/accent"
      android:textSize="13sp"
      android:textStyle="bold"
      android:gravity="end"/>

    <SeekBar
      android:id="@+id/seekBass"
      style="@style/SeekBar.Equalizer"
      android:layout_width="0dp"
      android:layout_height="32dp"
      android:layout_weight="2"
      android:layout_marginStart="10dp"
      android:max="100"
      android:progress="0"/>

  </LinearLayout>

  <!-- Amplifier row -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingBottom="4dp">

    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:src="@drawable/ic_amplifier"
      android:tint="@color/on_surface_variant"/>

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:text="@string/amplifier"
      android:textColor="@color/on_surface"
      android:textSize="14sp"/>

    <TextView
      android:id="@+id/tvAmpVal"
      android:layout_width="44dp"
      android:layout_height="wrap_content"
      android:text="0 dB"
      android:textColor="@color/accent"
      android:textSize="13sp"
      android:textStyle="bold"
      android:gravity="end"/>

    <SeekBar
      android:id="@+id/seekAmplifier"
      style="@style/SeekBar.Equalizer"
      android:layout_width="0dp"
      android:layout_height="32dp"
      android:layout_weight="2"
      android:layout_marginStart="10dp"
      android:max="15"
      android:progress="0"/>

  </LinearLayout>

</LinearLayout>
