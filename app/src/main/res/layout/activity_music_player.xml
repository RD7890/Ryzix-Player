<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/music_bg_dark"
  android:fitsSystemWindows="true">

  <!-- Blurred/darkened album art background -->
  <ImageView
    android:id="@+id/imgBgArt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:alpha="0.25"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

  <!-- Dark gradient overlay -->
  <View
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_bottom"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

  <!-- Top bar: back + title + more -->
  <ImageButton
    android:id="@+id/btnBack"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:src="@drawable/ic_back"
    android:tint="#FFFFFF"
    android:contentDescription="Back"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"/>

  <TextView
    android:id="@+id/tvNowPlaying"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="@string/now_playing"
    android:textColor="#99FFFFFF"
    android:textSize="11sp"
    android:textStyle="bold"
    android:letterSpacing="0.15"
    android:gravity="center"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toEndOf="@id/btnBack"
    app:layout_constraintEnd_toStartOf="@+id/btnMoreOptions"/>

  <ImageButton
    android:id="@+id/btnMoreOptions"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="8dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:src="@drawable/ic_more_vert"
    android:tint="#CCFFFFFF"
    android:contentDescription="More"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

  <!-- Album art (large, centered) -->
  <FrameLayout
    android:id="@+id/frameAlbumArt"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginHorizontal="40dp"
    android:layout_marginTop="24dp"
    android:background="@drawable/bg_music_art"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:elevation="8dp"
    app:layout_constraintTop_toBottomOf="@id/btnBack"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintDimensionRatio="1:1"
    app:layout_constraintVertical_bias="0">

    <ImageView
      android:id="@+id/imgAlbumArt"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="centerCrop"/>

    <ImageView
      android:id="@+id/imgAlbumArtFallback"
      android:layout_width="80dp"
      android:layout_height="80dp"
      android:layout_gravity="center"
      android:src="@drawable/ic_music_note"
      android:tint="#33FFFFFF"/>

  </FrameLayout>

  <!-- Song info row: title + like -->
  <TextView
    android:id="@+id/tvSongTitle"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="32dp"
    android:layout_marginTop="28dp"
    android:layout_marginEnd="16dp"
    android:ellipsize="marquee"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:marqueeRepeatLimit="marquee_forever"
    android:scrollHorizontally="true"
    android:singleLine="true"
    android:textColor="#FFFFFF"
    android:textSize="22sp"
    android:textStyle="bold"
    app:layout_constraintTop_toBottomOf="@id/frameAlbumArt"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toStartOf="@+id/btnFavorite"/>

  <ImageButton
    android:id="@+id/btnFavorite"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginEnd="24dp"
    android:layout_marginTop="24dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:src="@drawable/ic_favorite_border"
    android:tint="#CCFFFFFF"
    android:contentDescription="Like"
    app:layout_constraintTop_toBottomOf="@id/frameAlbumArt"
    app:layout_constraintEnd_toEndOf="parent"/>

  <TextView
    android:id="@+id/tvArtistName"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="32dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="32dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#99FFFFFF"
    android:textSize="15sp"
    app:layout_constraintTop_toBottomOf="@id/tvSongTitle"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

  <!-- Seek bar -->
  <SeekBar
    android:id="@+id/seekBar"
    style="@style/SeekBar.Music"
    android:layout_width="0dp"
    android:layout_height="32dp"
    android:layout_marginHorizontal="24dp"
    android:layout_marginTop="24dp"
    android:paddingVertical="8dp"
    app:layout_constraintTop_toBottomOf="@id/tvArtistName"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

  <!-- Time labels -->
  <TextView
    android:id="@+id/tvPosition"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="28dp"
    android:text="0:00"
    android:textColor="#99FFFFFF"
    android:textSize="12sp"
    app:layout_constraintTop_toBottomOf="@id/seekBar"
    app:layout_constraintStart_toStartOf="parent"/>

  <TextView
    android:id="@+id/tvDuration"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="28dp"
    android:text="0:00"
    android:textColor="#99FFFFFF"
    android:textSize="12sp"
    app:layout_constraintTop_toBottomOf="@id/seekBar"
    app:layout_constraintEnd_toEndOf="parent"/>

  <!-- Secondary controls: shuffle + repeat -->
  <ImageButton
    android:id="@+id/btnShuffle"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginStart="24dp"
    android:layout_marginTop="16dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:src="@drawable/ic_shuffle"
    android:tint="#66FFFFFF"
    android:contentDescription="@string/shuffle"
    app:layout_constraintTop_toBottomOf="@id/tvPosition"
    app:layout_constraintStart_toStartOf="parent"/>

  <ImageButton
    android:id="@+id/btnRepeat"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginEnd="24dp"
    android:layout_marginTop="16dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:src="@drawable/ic_repeat"
    android:tint="#66FFFFFF"
    android:contentDescription="@string/repeat"
    app:layout_constraintTop_toBottomOf="@id/tvDuration"
    app:layout_constraintEnd_toEndOf="parent"/>

  <!-- Main controls: prev, play/pause, next -->
  <LinearLayout
    android:id="@+id/layoutMainControls"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="36dp"
    android:gravity="center"
    android:orientation="horizontal"
    app:layout_constraintTop_toBottomOf="@id/btnShuffle"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintVertical_bias="0.5">

    <ImageButton
      android:id="@+id/btnPrevious"
      android:layout_width="56dp"
      android:layout_height="56dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_skip_previous"
      android:tint="#CCFFFFFF"
      android:contentDescription="Previous"/>

    <ImageButton
      android:id="@+id/btnPlayPause"
      android:layout_width="72dp"
      android:layout_height="72dp"
      android:layout_marginHorizontal="24dp"
      android:background="@drawable/bg_music_control_circle"
      android:src="@drawable/ic_play"
      android:tint="#FFFFFF"
      android:contentDescription="Play / Pause"
      android:padding="18dp"/>

    <ImageButton
      android:id="@+id/btnNext"
      android:layout_width="56dp"
      android:layout_height="56dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_skip_next"
      android:tint="#CCFFFFFF"
      android:contentDescription="Next"/>

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
