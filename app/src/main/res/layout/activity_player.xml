<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/black">

  <!-- ── Video surface ─────────────────────────────────────────── -->
  <androidx.media3.ui.PlayerView
    android:id="@+id/playerView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/black"/>

  <!-- ── Seek time overlay (center, shown on double-tap seek) ─── -->
  <LinearLayout
    android:id="@+id/layoutSeekOverlay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_pill"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingVertical="16dp"
    android:visibility="gone">

    <TextView
      android:id="@+id/tvSeekTime"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="00:00"
      android:textColor="#FFFFFF"
      android:textSize="30sp"
      android:textStyle="bold"/>

    <TextView
      android:id="@+id/tvSeekDelta"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="+10s"
      android:textColor="#BBFFFFFF"
      android:textSize="13sp"/>

  </LinearLayout>

  <!-- ── Brightness indicator (left edge) ─────────────────────── -->
  <LinearLayout
    android:id="@+id/layoutBrightnessIndicator"
    android:layout_width="52dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical|start"
    android:layout_marginStart="12dp"
    android:background="@drawable/bg_indicator"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp"
    android:visibility="gone">

    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:src="@drawable/ic_brightness"
      android:tint="#FFFFFF"/>

    <TextView
      android:id="@+id/tvBrightnessIndicator"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="#FFFFFF"
      android:textSize="11sp"
      android:textStyle="bold"/>

  </LinearLayout>

  <!-- ── Volume indicator (right edge) ────────────────────────── -->
  <LinearLayout
    android:id="@+id/layoutVolumeIndicator"
    android:layout_width="52dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical|end"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_indicator"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp"
    android:visibility="gone">

    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:src="@drawable/ic_volume"
      android:tint="#FFFFFF"/>

    <TextView
      android:id="@+id/tvVolumeIndicator"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="#FFFFFF"
      android:textSize="11sp"
      android:textStyle="bold"/>

  </LinearLayout>

  <!-- ── Controls container ────────────────────────────────────── -->
  <FrameLayout
    android:id="@+id/controlsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TOP BAR -->
    <LinearLayout
      android:id="@+id/controlsTop"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top"
      android:background="@drawable/bg_gradient_top"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="4dp"
      android:paddingEnd="8dp"
      android:paddingTop="32dp"
      android:paddingBottom="20dp">

      <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:tint="#FFFFFF"
        android:contentDescription="Back"/>

      <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:shadowDx="0"
        android:shadowDy="1"/>

      <ImageButton
        android:id="@+id/btnAudioTrack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_audio_track"
        android:tint="#CCFFFFFF"
        android:contentDescription="Audio track"/>

      <ImageButton
        android:id="@+id/btnSubtitle"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_subtitle"
        android:tint="#CCFFFFFF"
        android:contentDescription="Subtitles"/>

      <TextView
        android:id="@+id/btnSpeed"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:background="@drawable/bg_speed_pill"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="1×"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"/>

      <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        android:tint="#CCFFFFFF"
        android:contentDescription="More"/>

    </LinearLayout>

    <!-- CENTER CONTROLS -->
    <LinearLayout
      android:id="@+id/controlsCenter"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <!-- Previous -->
      <ImageButton
        android:id="@+id/btnPrevious"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_skip_previous"
        android:tint="#99FFFFFF"
        android:contentDescription="Previous"/>

      <!-- Rewind 10s -->
      <LinearLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="10dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btnRewind"
          android:layout_width="52dp"
          android:layout_height="52dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_rewind"
          android:tint="#FFFFFF"
          android:contentDescription="Rewind 10 seconds"/>

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:text="10s"
          android:textColor="#AAFFFFFF"
          android:textSize="9sp"/>

      </LinearLayout>

      <!-- Play / Pause (hero button) -->
      <ImageButton
        android:id="@+id/btnPlayPause"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_control_circle_accent"
        android:src="@drawable/ic_pause"
        android:tint="#FFFFFF"
        android:contentDescription="Play / Pause"
        android:elevation="4dp"
        android:padding="18dp"/>

      <!-- Forward 10s -->
      <LinearLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="10dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btnForward"
          android:layout_width="52dp"
          android:layout_height="52dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_forward"
          android:tint="#FFFFFF"
          android:contentDescription="Forward 10 seconds"/>

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:text="10s"
          android:textColor="#AAFFFFFF"
          android:textSize="9sp"/>

      </LinearLayout>

      <!-- Next -->
      <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_skip_next"
        android:tint="#99FFFFFF"
        android:contentDescription="Next"/>

    </LinearLayout>

    <!-- BOTTOM CONTROLS -->
    <LinearLayout
      android:id="@+id/controlsBottom"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:background="@drawable/bg_gradient_bottom"
      android:orientation="vertical"
      android:paddingHorizontal="16dp"
      android:paddingTop="20dp"
      android:paddingBottom="24dp">

      <!-- Seekbar row -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvPosition"
          android:layout_width="46dp"
          android:layout_height="wrap_content"
          android:text="0:00"
          android:textColor="#FFFFFF"
          android:textSize="12sp"
          android:textStyle="bold"
          android:gravity="start"/>

        <SeekBar
          android:id="@+id/seekBar"
          style="@style/SeekBar.Player"
          android:layout_width="0dp"
          android:layout_height="32dp"
          android:layout_marginHorizontal="6dp"
          android:layout_weight="1"
          android:paddingVertical="8dp"/>

        <TextView
          android:id="@+id/tvDuration"
          android:layout_width="46dp"
          android:layout_height="wrap_content"
          android:text="0:00"
          android:textColor="#99FFFFFF"
          android:textSize="12sp"
          android:gravity="end"/>

      </LinearLayout>

      <!-- Bottom action row -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
          android:id="@+id/btnLock"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_lock_open"
          android:tint="#CCFFFFFF"
          android:contentDescription="Lock screen"/>

        <View
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:layout_weight="1"/>

        <TextView
          android:id="@+id/tvCodec"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_tag"
          android:paddingHorizontal="8dp"
          android:paddingVertical="3dp"
          android:text="HW"
          android:textColor="#AAFFFFFF"
          android:textSize="10sp"
          android:textStyle="bold"/>

        <ImageButton
          android:id="@+id/btnEqualizer"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:layout_marginStart="8dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_equalizer"
          android:tint="#CCFFFFFF"
          android:contentDescription="Equalizer"/>

        <ImageButton
          android:id="@+id/btnAspect"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_aspect"
          android:tint="#CCFFFFFF"
          android:contentDescription="Aspect Ratio"/>

        <ImageButton
          android:id="@+id/btnRotate"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_rotate"
          android:tint="#CCFFFFFF"
          android:contentDescription="Rotate"/>

        <ImageButton
          android:id="@+id/btnPip"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_pip"
          android:tint="#CCFFFFFF"
          android:contentDescription="Picture in Picture"/>

      </LinearLayout>

    </LinearLayout>

  </FrameLayout>

  <!-- ── Lock overlay ──────────────────────────────────────────── -->
  <FrameLayout
    android:id="@+id/lockOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_vertical|start"
      android:layout_marginStart="16dp"
      android:background="@drawable/bg_indicator"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="12dp">

      <ImageButton
        android:id="@+id/btnUnlock"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@null"
        android:src="@drawable/ic_lock"
        android:tint="#FFFFFF"
        android:contentDescription="Unlock screen"/>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/locked"
        android:textColor="#BBFFFFFF"
        android:textSize="9sp"/>

    </LinearLayout>

  </FrameLayout>

</FrameLayout>
